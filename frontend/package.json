{
  "name": "data-visualization-dashboard",
  "version": "1.0.0",
  "description": "A data visualization dashboard built with React, TypeScript, and Chart.js",
  "private": true,
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-query": "3.39.3",
    "chart.js": "4.5.1",
    "react-chartjs-2": "5.3.1",
    "tailwindcss": "3.4.19",
    "axios": "1.19.0"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@testing-library/react": "14.3.1",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/user-event": "14.6.3",
    "typescript": "5.9.3",
    "vite": "4.5.14",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "jest": "29.7.0",
    "ts-jest": "29.4.12",
    "jest-environment-jsdom": "29.5.0",
    "@types/jest": "29.5.12",
    "jest-junit": "16.0.0",
    "msw": "1.3.5",
    "@reduxjs/toolkit": "1.9.7",
    "react-redux": "8.1.3",
    "react-router-dom": "6.22.3",
    "zod": "3.22.4",
    "dayjs": "1.11.10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:e2e": "npm --prefix ../e2e run test",
    "lint": "eslint src --ext .ts,.tsx",
    "preview": "vite preview"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}