# ---------------------------------------------------------------------------
# Code Skeptic Scanner - repository ignore rules
#
# Scope: test artifacts, the dependency trees the suites install, the local
# development virtual environments, and the evidence a verification run
# captures. Nothing here ignores a source file.
#
# `backend/tests/test_coverage_gate.py` and
# `frontend/src/test-utils/dependency-closure.test.ts` hold this file to that
# scope. Reasoning: docs/testing/DECISION-LOG.md.
# ---------------------------------------------------------------------------

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage.xml
coverage.json
coverage.lcov
htmlcov/
backend/reports/

# Frontend artifacts
frontend/coverage/
frontend/reports/

# Dashboard readings produced by docs/testing/dashboard-extract.py
docs/testing/reports/

# Dependency trees
node_modules/
e2e/node_modules/

# --- npm lockfiles: generated by the documented install, not committed ---
# Both rules are path-anchored to the two packages that have a manifest, so a
# lockfile at any other path stays visible rather than being suppressed by a
# bare pattern. `npm ci` refuses to run without a lockfile, so committing one
# is the only way to make it usable - and that decision is taken elsewhere: the
# three Node install steps of .github/workflows/ci.yml all use `npm install`.
# Until it is reversed, these two files are output of a documented command and
# not deliverables, and `git add -f` is what overrides these rules.
# frontend/src/test-utils/dependency-closure.test.ts asserts exactly this shape.
frontend/package-lock.json
e2e/package-lock.json

# --- Local environment file read by backend/app/core/config.py ---
# `Settings.Config.env_file` names `.env`, so a file here is configuration that
# a developer supplies and pydantic reads. It is never a deliverable, and it is
# the file a real credential would be pasted into.
.env

# --- Playwright / e2e artifacts ---
e2e/test-results/
e2e/playwright-report/
e2e/reports/

# --- Browser/desktop evidence captured during verification runs ---
blitzy/screenshots/
blitzy/screen_recordings/

# --- Local development environments (.venv-backend is the CPython 3.9 backend venv) ---
.venv-backend/
venv/
env/
ENV/
