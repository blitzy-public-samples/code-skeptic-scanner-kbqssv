# ---------------------------------------------------------------------------
# Code Skeptic Scanner - repository ignore rules
#
# Scope: test artifacts, the dependency trees the suites install, the local
# development virtual environments, and the evidence a verification run
# captures. Nothing here ignores a source file.
#
# `backend/tests/test_coverage_gate.py` and
# `frontend/src/test-utils/dependency-closure.test.ts` hold this file to that
# scope. Reasoning: docs/testing/DECISION-LOG.md.
# ---------------------------------------------------------------------------

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
coverage.xml
coverage.json
coverage.lcov
htmlcov/
backend/reports/

# Frontend artifacts
frontend/coverage/
frontend/reports/

# Dashboard readings produced by docs/testing/dashboard-extract.py
docs/testing/reports/

# Dependency trees
node_modules/
e2e/node_modules/

# --- npm lockfiles: deliberately NOT ignored ---
# No `package-lock.json` rule here, and there must not be one: `npm ci` refuses
# to run without a lockfile. frontend/src/test-utils/dependency-closure.test.ts
# asserts that no active rule in this file names one.

# --- Playwright / e2e artifacts ---
e2e/test-results/
e2e/playwright-report/
e2e/reports/

# --- Browser/desktop evidence captured during verification runs ---
blitzy/screenshots/
blitzy/screen_recordings/

# --- Local development environments (.venv-backend is the CPython 3.9 backend venv) ---
.venv-backend/
venv/
env/
ENV/
